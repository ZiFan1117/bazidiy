{
  "name": "@bazidiy/ontology",
  "description": "BaziDIY: deterministic bazi/wuxing/bead rules as dsh tools, plus bracelet SVG rendering and a bead editor",
  "version": "0.1.0",
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "assets/beads/*.png"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "clsx": "^2.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.2.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-persona": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-storage": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-storage-json": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tool-ask-user": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-user-questions": ">=0.1.1-rc.1 <0.2.0-0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "~18.3.1",
    "jsdom": "^29.0.0",
    "react": "^18.2.0",
    "sharp": "0.35.3"
  }
}
