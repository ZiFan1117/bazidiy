@prefix bzd: <https://bazidiy.example/ontology#> .

# 款式 ttl = 由 kb/ossie(SQLite) 导出的 OWL 视图（非权威）

bzd:StyleLibraryOntology a owl:Ontology .

bzd:Style a owl:Class .
bzd:config a owl:DatatypeProperty .

bzd:B-01 a bzd:Style .
bzd:B-01 bzd:config "{\"name\":\"素圈单圈手串\",\"positions\":[{\"slot\":0,\"role\":\"main\",\"variant_filter\":[\"round\",\"buddha\",\"barrel\"]}],\"constraints\":[]}" .

bzd:B-02 a bzd:Style .
bzd:B-02 bzd:config "{\"name\":\"主珠款单圈手串\",\"positions\":[{\"slot\":0,\"role\":\"main\",\"min_dia\":10,\"variant_filter\":[\"round\",\"buddha\"]},{\"slot\":1,\"role\":\"spacer\",\"variant_filter\":[\"spacer\"]},{\"slot\":2,\"role\":\"body\",\"min_dia\":6,\"max_dia\":8,\"variant_filter\":[\"round\",\"buddha\"]},{\"slot\":-1,\"role\":\"spacer\",\"variant_filter\":[\"spacer\"]}],\"constraints\":[{\"name\":\"diameter\",\"type\":\"diameter\",\"variables\":[\"v0\",\"v2\",\"v1\"],\"params\":{\"main_min\":10,\"body\":[6,8]},\"reason\":\"主珠≥10mm,体珠6或8mm\"},{\"name\":\"spacer\",\"type\":\"spacer_map\",\"variables\":[\"v1\",\"v2\"],\"reason\":\"隔片-体珠映射\"}]}" .

bzd:B-03 a bzd:Style .
bzd:B-03 bzd:config "{\"name\":\"隔片款单圈手串\",\"positions\":[{\"slot\":0,\"role\":\"main\",\"variant_filter\":[\"round\",\"buddha\"]},{\"slot\":1,\"role\":\"main\",\"variant_filter\":[\"round\",\"buddha\"]},{\"slot\":2,\"role\":\"spacer\",\"variant_filter\":[\"spacer\"]}],\"constraints\":[{\"name\":\"same_main\",\"type\":\"same_bead\",\"variables\":[\"v0\",\"v1\"],\"reason\":\"材质一致\"}]}" .

bzd:B-10 a bzd:Style .
bzd:B-10 bzd:config "{\"name\":\"五行拼色单圈手串\",\"positions\":[{\"slot\":0,\"role\":\"wuxing\",\"variant_filter\":[\"round\",\"buddha\"]}],\"constraints\":[]}" .

bzd:spacerMap a owl:Class .
bzd:spacerMap6 a bzd:spacerMap .
bzd:spacerMap6 bzd:body 6 .
bzd:spacerMap6 bzd:spacer 4 .
bzd:spacerMap8 a bzd:spacerMap .
bzd:spacerMap8 bzd:body 8 .
bzd:spacerMap8 bzd:spacer 4 .
bzd:spacerMap10 a bzd:spacerMap .
bzd:spacerMap10 bzd:body 10 .
bzd:spacerMap10 bzd:spacer 5 .
bzd:spacerMap12 a bzd:spacerMap .
bzd:spacerMap12 bzd:body 12 .
bzd:spacerMap12 bzd:spacer 6 .
