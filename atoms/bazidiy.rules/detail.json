    "classDiagram": [
      "class Rules { +loadRelations() +follows() +deriveElements() +judgeStrength() +chooseVerdict() +checkConsistency() +listRules() +ruleById() +isWuxingElement() +assertSingleWuxing() +validateWuxingData() }",
