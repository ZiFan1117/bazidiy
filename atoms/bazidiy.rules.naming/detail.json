  "language": {
    "content": "zh-CN",
    "identifiers": "en"
  },
  "layer": "primitive",
  "category": "other",
  "side_effects": "none",
  "lang": "rule-data + evaluator",
  "intent": "定义珠子命名规则：必须全称、禁止缩写、同名变体优先非隔片",
  "when_to_use": "适用：解析珠序前校验与消歧，杜绝“白玉/玛瑙”等编造名与缩写。",
  "tags_en": [
    "rule",
    "naming",
    "bead",
    "canonical"
  ],
  "deps": [
    "bazidiy.kb.bead_catalog"
  ],
  "implementation_ref": "bazidiy @bazidiy/ontology: atoms/bazidiy.rules.naming/impl/index.ts（VALID_NAMES + resolveVariant 消歧）",
  "io": {
    "input": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "珠子名（须全称）"
        },
        "diameter": {
          "type": "integer"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "bead_id": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "tests": []
  },
  "disclosure": {
    "list": "frontmatter id+intent(+when_to_use)",
    "detail": "body (four ## sections + four mermaid)",
    "machine": "atoms/bazidiy.rules.naming/detail.json"
  },
  "diagrams": {
    "flow": [
      "IN[name, diameter] --> A{name 在全称集合?}",
      "A -- 否 --> OUT[rejected + reason]",
      "A -- 是 --> B[同名变体: 直径匹配优先]",
      "B --> C[仍多则 round 优先]",
      "C --> OUT2[canonical bead_id + variant]"
    ],
    "classDiagram": [
      "class NamingRule { +isCanonical(name) +resolveVariant(name, dia) }",
      "NamingRule --> BeadCatalog : VALID_NAMES/同名集合",
      "NamingRule : preferNonSpacer"
    ],
    "sequence": [
      "participant U as parse_slots",
      "participant N as NamingRule",
      "U->>N: isCanonical(玛瑙)",
      "N-->>U: false(不在库)",
      "U->>N: resolveVariant(小叶紫檀,10)",
      "N-->>U: xiaoye-zitan_round"
    ],
    "callGraph": [
      "isCanonical --> catalogNames",
      "resolveVariant --> filterByDiameter",
      "filterByDiameter --> preferRound"
    ]
  },
  "when": [
    "适用：解析珠序前校验与消歧，杜绝“白玉/玛瑙”等编造名与缩写。",
    "不适用：不做珠序整体解析。"
  ],
  "example": "输入 { name:\"小叶紫檀\", diameter:10 } → { ok:true, bead_id:\"xiaoye-zitan\", variant:\"round\" }；输入 { name:\"玛瑙\" } → { ok:false, reason:\"不在库全称集合\" }。"
}
