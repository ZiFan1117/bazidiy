{
  "schema": "bazidiy-atom-detail",
  "atom": "bazidiy.styles",
  "file": "bazidiy.styles.atom.md",
  "language": {
    "content": "zh-CN",
    "identifiers": "en"
  },
  "layer": "capability",
  "category": "other",
  "side_effects": "none",
  "lang": "typescript",
  "intent": "从款式库构建 Style/Position/Constraint，并提供候选过滤与约束校验器",
  "when_to_use": "适用：任何按款式槽位筛选候选珠或校验一组珠子的场景；求解枚举在 solve_styles。",
  "tags_en": [
    "style",
    "constraint",
    "position",
    "spacer",
    "validator"
  ],
  "deps": [
    "bazidiy.kb"
  ],
  "implementation_ref": "bazidiy @bazidiy/ontology: atoms/bazidiy.styles/impl/index.ts（loadStyles/candidatesFor/checkConstraint）",
  "io": {
    "input": {
      "type": "object",
      "properties": {
        "style_id": {
          "type": "string",
          "description": "B-01/B-02/B-03/B-10"
        },
        "bead": {
          "type": "object"
        },
        "constraint_type": {
          "type": "string",
          "enum": [
            "diameter",
            "spacer_map",
            "same_bead"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "styles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "candidate": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "spacer_map": {
          "type": "object"
        }
      }
    },
    "tests": [
      {
        "input": {
          "style_id": "B-02"
        },
        "expect": {
          "positions": 4,
          "constraints": 2
        }
      }
    ]
  },
  "disclosure": {
    "list": "frontmatter id+intent(+when_to_use)",
    "detail": "body (four ## sections + four mermaid)",
    "machine": "atoms/bazidiy.styles/detail.json"
  },
  "diagrams": {
    "flow": [
      "KB[kb: styleLibrary] --> L[loadStyles]",
      "L --> S[Style / Position / Constraint]",
      "B[bead] --> C{candidatesFor}",
      "S --> C",
      "C --> OUT[可入槽 / 不可入槽]",
      "S --> K{checkConstraint}",
      "K --> OK[约束满足 / 不满足]"
    ],
    "classDiagram": [
      "class Styles { +loadStyles() +candidatesFor() +checkConstraint() }",
      "class Position { +slot +role +min_dia +max_dia +variant_filter }",
      "class Constraint { +name +type +variables +params }",
      "Styles --> Position",
      "Styles --> Constraint",
      "Styles --> StyleLibrary"
    ],
    "sequence": [
      "participant S as solve_styles",
      "participant Y as styles",
      "S->>Y: loadStyles()",
      "Y-->>S: 四款式结构",
      "S->>Y: candidatesFor(bead, position)",
      "Y-->>S: true/false",
      "S->>Y: checkConstraint('spacer_map', beads, {})",
      "Y-->>S: true/false"
    ],
    "callGraph": [
      "solve_styles --> styles",
      "styles --> styleLibrary",
      "styles --> SPACER_MAP"
    ]
  },
  "when": [
    "适用：任何按款式槽位筛选候选珠或校验一组珠子的场景；求解枚举在 solve_styles。",
    "不适用：不做组合枚举/珠数计算（bazidiy.solve_styles）；不定义款式数据（bazidiy.kb）。"
  ],
  "example": "输入 { style_id:\"B-02\" } → 4 个槽位 + 2 条约束（diameter、spacer_map）；candidatesFor(南红, {variant_filter:['round']}) → true；checkConstraint('unknown', …) 抛错。"
}
