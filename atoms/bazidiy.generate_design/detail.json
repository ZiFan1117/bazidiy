{
  "schema": "bazidiy-atom-detail",
  "atom": "bazidiy.generate_design",
  "file": "bazidiy.generate_design.atom.md",
  "language": {
    "content": "zh-CN",
    "identifiers": "en"
  },
  "layer": "capability",
  "category": "other",
  "side_effects": "none",
  "lang": "typescript",
  "intent": "解析并校验完整珠序后定稿最终手串方案",
  "when_to_use": "适用：模型从 propose 的 designs 挑一款后“逐字照抄”珠序定稿出图。",
  "tags_en": [
    "design",
    "generate",
    "validate",
    "slots"
  ],
  "deps": [
    "bazidiy.parse_slots",
    "bazidiy.rules.naming",
    "bazidiy.kb.bead_catalog"
  ],
  "implementation_ref": "bazidiy @bazidiy/ontology: src/index.ts generate_design 工具壳",
  "io": {
    "input": {
      "type": "object",
      "required": [
        "style_name",
        "beads",
        "summary"
      ],
      "properties": {
        "style_name": {
          "type": "string",
          "description": "款式编号 B-01/02/03/10"
        },
        "beads": {
          "type": "string"
        },
        "wrist_size": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "description": "≤50 字"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "design_result"
        },
        "style_name": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "wrist_size": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "tests": []
  },
  "disclosure": {
    "list": "frontmatter id+intent(+when_to_use)",
    "detail": "body (four ## sections + four mermaid)",
    "machine": "atoms/bazidiy.generate_design/detail.json"
  },
  "diagrams": {
    "flow": [
      "IN[style_name, beads, summary, rationale] --> P[parse_slots 解析珠序]",
      "P --> C{解析通过?}",
      "C -- 否 --> OUT[design_result + note 珠名未识别]",
      "C -- 是 --> OUT2[design_result + slots(w/ image/ratio) + presentationMeta]"
    ],
    "classDiagram": [
      "class Generator { +generateDesign(...) }",
      "Generator --> SlotParser",
      "Generator --> NamingRule",
      "Generator --> BeadCatalog : VALID_NAMES"
    ],
    "sequence": [
      "participant U as Agent (generate_design 工具)",
      "participant G as Generator",
      "U->>G: generate_design(B-02, \"南红:8,碎银子:4,南红:8\", …)",
      "G->>G: parse+校验",
      "G-->>U: design_result(slots×3)"
    ],
    "callGraph": [
      "generateDesign --> parseSlots",
      "parseSlots --> isCanonical",
      "parseSlots --> resolveBead",
      "generateDesign --> buildNote"
    ]
  },
  "when": [
    "适用：模型从 propose 的 designs 挑一款后“逐字照抄”珠序定稿出图。",
    "不适用：不重新排盘/判喜忌；不接受缩写、库外珠名、自创珠序。"
  ],
  "example": "输入 { style_name:\"B-02\", beads:\"南红:8,碎银子:4,南红:8\", wrist_size:\"17\", summary:\"…\" } → { type:\"design_result\", slots:[{name:南红,diameter:8,…}×3] }；若写成\"玛瑙:8\" → 输出含 note 的拒绝结果。"
}
