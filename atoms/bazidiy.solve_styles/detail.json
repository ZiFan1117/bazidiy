{
  "schema": "bazidiy-atom-detail",
  "atom": "bazidiy.solve_styles",
  "file": "bazidiy.solve_styles.atom.md",
  "language": {
    "content": "zh-CN",
    "identifiers": "en"
  },
  "layer": "capability",
  "category": "other",
  "side_effects": "none",
  "lang": "typescript",
  "intent": "按款式槽位约束枚举组合，求腕围下可行方案与不可行款式原因",
  "when_to_use": "适用：给可用珠+腕围产出一组可选款式方案。",
  "tags_en": [
    "solver",
    "style",
    "constraint",
    "enumeration"
  ],
  "deps": [
    "bazidiy.kb.style_library",
    "bazidiy.kb.bead_catalog"
  ],
  "implementation_ref": "bazidiy @bazidiy/ontology: src/solver.ts（beadCount + 约束枚举）",
  "io": {
    "input": {
      "type": "object",
      "required": [
        "suitable_beads",
        "wrist_size"
      ],
      "properties": {
        "suitable_beads": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "wrist_size": {
          "type": "integer",
          "description": "腕围 cm"
        },
        "max_proposals": {
          "type": "integer"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "style": {
                "type": "string"
              },
              "style_name": {
                "type": "string"
              },
              "beads": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              }
            }
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "style": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tests": []
  },
  "disclosure": {
    "list": "frontmatter id+intent(+when_to_use)",
    "detail": "body (four ## sections + four mermaid)",
    "machine": "atoms/bazidiy.solve_styles/detail.json"
  },
  "diagrams": {
    "flow": [
      "IN[styles, suitable_beads, wrist_size] --> S[按款式构造域]",
      "S --> E[递归枚举(笛卡尔 + 剪枝)]",
      "E --> C{逐约束 checkConstraint?}",
      "C -- 不满足 --> X[unavailable + reason]",
      "C -- 满足 --> EXP[expandDesign + beadCount]",
      "EXP --> OUT[proposals[]]"
    ],
    "classDiagram": [
      "class StyleSolver { +solveStyles() }",
      "StyleSolver : beadCount(wrist,dia)",
      "StyleSolver : solveConstraints(domains)",
      "StyleSolver : expandDesign(style,solution)",
      "StyleSolver --> StyleLibrary",
      "StyleSolver --> BeadCatalog",
      "StyleSolver : checkConstraint(type, beads)"
    ],
    "sequence": [
      "participant U as propose_designs",
      "participant S as StyleSolver",
      "U->>S: solveStyles(款式全集, 可用珠, 17)",
      "S->>S: B-01→素圈方案；B-02→主珠+隔片方案…",
      "S-->>U: proposals + unavailable(如 B-10 缺五行各一珠)"
    ],
    "callGraph": [
      "solveStyles --> perStyle",
      "perStyle --> solveConstraints",
      "solveConstraints --> checkConstraint",
      "solveStyles --> beadCount",
      "solveStyles --> b10Proposals"
    ]
  },
  "when": [
    "适用：给可用珠+腕围产出一组可选款式方案。",
    "不适用：不判喜忌；不做最终定稿文案。"
  ],
  "example": "输入 { suitable_beads:[木金土…], wrist_size:17 } → { proposals:[{style:B-01, beads:\"小叶紫檀:8,…\", count:22}…], unavailable:[{style:B-10, reason:\"五行各缺一种可选珠\"}] }。"
}
