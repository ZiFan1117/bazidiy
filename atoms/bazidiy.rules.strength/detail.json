  "intent": "依据月令与日主关系判定日主旺衰（得令/得生）",
  "when_to_use": "适用：在喜忌选择之前判定日主强弱；判据变更只改规则数据。",
  "tags_en": [
    "rule",
    "wuxing",
    "strength",
    "deterministic"
  ],
  "deps": [
    "bazidiy.kb.wuxing_ganzhi"
  ],
  "implementation_ref": "bazidiy @bazidiy/ontology: src/data/wuxing.ts strength_rules",
  "io": {
    "input": {
      "type": "object",
      "required": [
        "day_master_element",
        "month_branch_wuxing"
      ],
      "properties": {
        "day_master_element": {
          "type": "string",
          "description": "单字五行：金/木/水/火/土"
