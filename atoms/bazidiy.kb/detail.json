  "file": "bazidiy.kb.atom.md",
  "language": {
    "content": "zh-CN",
    "identifiers": "en"
  },
  "layer": "primitive",
  "category": "data",
  "side_effects": "none",
  "lang": "ossie yaml + sqlite",
  "intent": "BaziDIY 领域本体与数据：五行/干支/节气 + 珠料×变体=珠 + 款式槽位（Apache Ossie 合并篇）",
  "when_to_use": "全领域概念/关系/约束与实例数据唯一源（ontology.yaml + semantic 契约 + SQLite）；其它原子经绑定/契约引用",
  "tags_en": [
    "ontology",
    "kb",
    "wuxing",
    "bead",
    "style",
    "ossie"
  ],
  "deps": [],
  "implementation_ref": "bazidiy @bazidiy/ontology: kb/ossie/ontology.yaml（合并篇）+ {bead,wuxing,style}_catalog.semantic.yaml + data/*.sql（Apache Ossie v0.2）→ tools/gen-ossie-db.mjs/gen-bindings.mjs 生成绑定；资源 assets/beads/*.png",
  "io": {
    "input": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "wuxing",
            "bead",
            "style"
          ]
        },
        "term": {
          "type": "string",
          "description": "可选：概念/术语查询"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "ontology": {
          "type": "object"
        },
        "datasets": {
          "type": "array"
        },
        "bindings": {
          "type": "object"
        }
      }
    },
    "tests": [
      {
        "input": {
          "domain": "bead",
          "term": "nanhong_round"
        },
        "expect": {
          "name": "南红",
          "wuxing": "火"
        }
      }
    ]
  },
  "disclosure": {
    "list": "frontmatter id+intent(+when_to_use)",
    "detail": "body (four ## sections + four mermaid)",
    "machine": "atoms/bazidiy.kb/detail.json"
  },
  "diagrams": {
    "flow": [
      "O[ontology.yaml 合并篇] --> DB[gen-ossie-db: SQLite 建库+自检]",
      "C[bead/wuxing/style semantic 契约] --> DB",
      "DB --> B[gen-bindings: TS 绑定 + ttl 导出]",
      "Q[按领域/术语查询] --> B",
      "B --> OUT[概念/关系/实例]"
    ],
    "classDiagram": [
      "class kb { +ontology.yaml +bead_catalog.semantic.yaml +wuxing_catalog.semantic.yaml +style_catalog.semantic.yaml +data/*.sql }",
      "class Bindings",
      "kb --> Bindings"
    ],
    "sequence": [
      "participant A as 其它原子/引擎",
      "participant K as bazidiy.kb",
      "A->>K: 查词表/珠子/款式",
      "K->>K: gen 绑定只读",
      "K-->>A: 数据/契约"
    ],
    "callGraph": [
      "rules --> bazidiy.kb",
      "calculate_chart --> bazidiy.kb",
      "infer_verdict --> bazidiy.kb",
      "solve_styles --> bazidiy.kb"
    ]
  },
  "when": [
    "适用：全领域概念/实例/契约的权威来源；构建其它原子与对外数据接口。",
    "不适用：不做判据/求解（那是 rules 与能力原子）。",
    "共享类型契约（Bead / DesignOption / WuxingVerdict 等）以 impl/contracts.ts 随本原子发布，供其它原子相对引用；不再单独设 __shared 目录。"
  ],
  "example": "输入 { domain:\"bead\", term:\"nanhong_round\" } → 输出该珠实例（材料/变体/五行/直径/图）；输入 { domain:\"wuxing\", term:\"金\" } → 生=水、克=木。"
}
